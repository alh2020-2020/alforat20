+def customer_action(request: Request):
+    if request.headers.get('x-store-action') != 'customer':
+        raise HTTPException(403, 'أعد تحميل الصفحة وحاول مجدداً')
+
+
+def limit_customer_auth(request: Request, action: str, limit: int):
+    ip = request.client.host if request.client else 'unknown'
+    now = int(time.time())
+    with closing(conn()) as db:
+        db.execute('BEGIN IMMEDIATE')
+        db.execute('DELETE FROM customer_auth_limits WHERE started <= ?', (now - 600,))
+        row = db.execute(
+            'SELECT attempts FROM customer_auth_limits WHERE ip=? AND action=?', (ip, action)
+        ).fetchone()
+        if row and row['attempts'] >= limit:
+            raise HTTPException(429, 'محاولات كثيرة. حاول مرة أخرى لاحقاً.')
+        db.execute('''INSERT INTO customer_auth_limits VALUES (?,?,?,1)
+            ON CONFLICT(ip, action) DO UPDATE SET attempts=attempts+1''', (ip, action, now))
+        db.commit()
+
+
+def customer_token_hash(request: Request):
+    return hashlib.sha256(request.cookies.get(CUSTOMER_COOKIE, '').encode()).hexdigest()
+
+
+def current_customer(request: Request):
+    if not request.cookies.get(CUSTOMER_COOKIE):
+        return None
+    with closing(conn()) as db:
+        return db.execute('''SELECT c.id, c.name, c.email FROM customers c
+            JOIN customer_sessions s ON s.customer_id=c.id
+            WHERE s.token_hash=? AND s.expires>?''',
+            (customer_token_hash(request), int(time.time()))).fetchone()
+
+
+def start_customer_session(db, customer_id, request, response):
+    token = secrets.token_urlsafe(36)
+    now = int(time.time())
+    db.execute('DELETE FROM customer_sessions WHERE expires<=? OR token_hash=?',
+               (now, customer_token_hash(request)))
+    db.execute('INSERT INTO customer_sessions VALUES (?,?,?)',
+               (hashlib.sha256(token.encode()).hexdigest(), customer_id, now + SESSION_AGE))
+    response.set_cookie(CUSTOMER_COOKIE, token, max_age=SESSION_AGE, httponly=True,
+                        samesite='strict', secure=(request.url.scheme == 'https'
+                            or bool(os.environ.get('RAILWAY_ENVIRONMENT'))
+                            or os.environ.get('FORCE_SECURE_COOKIE') == '1'), path='/')
+    response.headers['Cache-Control'] = 'no-store'
+
+
+DUMMY_CUSTOMER_HASH = hash_password(secrets.token_urlsafe(24))
+
+
+@app.post('/api/account/register', status_code=201, dependencies=[Depends(customer_action)])
+def customer_register(data: CustomerRegistration, request: Request, response: Response):
+    limit_customer_auth(request, 'register', 10)
+    customer_id = uuid.uuid4().hex
+    password_hash = hash_password(data.password)
+    with closing(conn()) as db:
+        db.execute('BEGIN IMMEDIATE')
+        inserted = db.execute('''INSERT INTO customers VALUES (?,?,?,?,?)
+            ON CONFLICT(email) DO NOTHING''',
+            (customer_id, data.email, data.name, password_hash, utc_now()))
+        if not inserted.rowcount:
+            raise HTTPException(409, 'تعذر إنشاء الحساب بهذا البريد. جرّب تسجيل الدخول.')
+        start_customer_session(db, customer_id, request, response)
+        db.commit()
+    return {'ok': True}
+
+
+@app.post('/api/account/login', dependencies=[Depends(customer_action)])
+def customer_login(data: CustomerLogin, request: Request, response: Response):
+    limit_customer_auth(request, 'login', 20)
+    with closing(conn()) as db:
+        row = db.execute('SELECT id, password_hash FROM customers WHERE email=?', (data.email,)).fetchone()
+        valid = check_password(data.password, row['password_hash'] if row else DUMMY_CUSTOMER_HASH)
+        if not valid or not row:
+            raise HTTPException(401, 'البريد الإلكتروني أو كلمة المرور غير صحيحة')
+        db.execute('BEGIN IMMEDIATE')
+        start_customer_session(db, row['id'], request, response)
+        db.commit()
+    return {'ok': True}
+
+
+@app.post('/api/account/logout', dependencies=[Depends(customer_action)])
+def customer_logout(request: Request, response: Response):
+    with closing(conn()) as db:
+        db.execute('DELETE FROM customer_sessions WHERE token_hash=?', (customer_token_hash(request),))
+    response.delete_cookie(CUSTOMER_COOKIE, path='/')
+    response.headers['Cache-Control'] = 'no-store'
+    return {'ok': True}
+
+
+@app.exception_handler(RequestValidationError)
